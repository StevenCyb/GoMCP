# Copy to .env (gomcp serve/watch read it, see --dotenv). Real environment wins.

# Public URL of this server (OAuth protected resource).
GOMCP_AUTH_RESOURCE=https://esm.example.com/mcp
# Issuer shown to MCP clients (Microsoft Entra ID, v2.0 endpoint).
GOMCP_AUTH_SERVERS=https://login.microsoftonline.com/<tenant-id>/v2.0

# Entra tenant id and the application (client) id of the API app registration.
ESM_ENTRA_TENANT=<tenant-id>
ESM_ENTRA_AUDIENCE=<api-client-id>

# Optional
# GOMCP_ADDR=127.0.0.1:8080
# GOMCP_STATE_KEY=<shared secret when running several instances>
